{
  // project-os markdown style (see tools/instructions/MARKDOWN.md):
  // prose is never hard-wrapped, frontmatter is required, inline HTML and long lines are fine.
  "default": true,
  "MD013": false, // line length — soft-wrap policy makes long lines intentional
  "MD033": false, // inline HTML — used by templates and checklists
  "MD041": false, // first line heading — notes start with YAML frontmatter
  "MD024": { "siblings_only": true }, // duplicate headings allowed across sections (e.g. per-tier test areas)
  "MD025": false // single H1 — templates and generated docs may carry more than one
}
